flowchart TD
    A["Inicio: GET /api/haberes/core/makeLiquidacionGeneral/general/{anho}/{mes}/{force}"] --> B[MakeLiquidacionGeneralController]
    B --> C[MakeLiquidacionGeneralService]
    C --> D["PersonaService.findAllLiquidables() (hexagonal)"]
    D --> E["LiquidacionProcesoService.crearProceso(total)"]
    E --> F["LiquidacionProcessor.procesarLiquidaciones"]
    F --> G{"Por cada persona"}
    G -->|OK| H[MakeLiquidacionService.liquidacionByLegajoId]
    H --> I["Actualiza progreso en LiquidacionProceso"]
    G -->|Error| J["Log de error y continúa"]
    I --> K{"¿Todas procesadas?"}
    K -- Sí --> L["Marca proceso como COMPLETED"]
    K -- No --> G
    L --> M["Fin: devuelve proceso con progreso"]
    M --> N["Seguimiento: GET /general/progress/{procesoId}"]
